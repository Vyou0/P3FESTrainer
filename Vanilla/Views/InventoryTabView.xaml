<UserControl x:Class="P3FESTrainer.Views.InventoryTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:P3FESTrainer.Controls"
             xmlns:local="clr-namespace:P3FESTrainer.Views">
    <UserControl.Resources>
        <local:ItemTypeToVisibilityConverter x:Key="ItemTypeToVisibility" />

        <Style x:Key="OwnedRowContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CFE4FB" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF5FC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="4">

        <!-- Picker and action panel -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="180" />
                    <ColumnDefinition Width="1*" MinWidth="120" />
                </Grid.ColumnDefinitions>
                <controls:SearchableComboBox x:Name="NameBox" Grid.Column="0" OpenAbove="True" />
                <controls:SearchableComboBox x:Name="CategoryBox" Grid.Column="1" Margin="4,0,0,0"
                                              ReadOnly="True" OpenAbove="True"
                                              SelectionCommitted="CategoryBox_SelectionCommitted" />
            </Grid>
            <StackPanel Orientation="Horizontal">
                <StackPanel x:Name="QtyPanel" Orientation="Horizontal">
                    <TextBlock Text="Qty (0-255):" VerticalAlignment="Center" />
                    <TextBox x:Name="QtyBox" Width="50" Margin="4,0" Text="99" VerticalContentAlignment="Center" />
                    <Button Content="Set" Click="SetQty_Click" />
                </StackPanel>
                <StackPanel x:Name="GivePanel" Orientation="Horizontal" Visibility="Collapsed">
                    <Button Content="Add" Click="GiveSelected_Click" />
                </StackPanel>
                <TextBlock x:Name="ResultText" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
            <TextBlock Text="Search Owned:" Margin="0,0,0,2" />
            <TextBox x:Name="SearchBox" Padding="2,2,4,2" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
        </StackPanel>

        <!-- Owned list and detail panel -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="1*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Owned" Grid.Column="0">
                <ListBox x:Name="OwnedGrid" Background="White" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource OwnedRowContainerStyle}"
                         SelectionMode="Single"
                         SelectionChanged="OwnedGrid_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <TextBox DockPanel.Dock="Right" Width="60" Margin="6,0,0,0"
                                         VerticalAlignment="Center" VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Right"
                                         Text="{Binding DetailText, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                         Visibility="{Binding Type, Converter={StaticResource ItemTypeToVisibility}}"
                                         LostFocus="OwnedQtyBox_LostFocus"
                                         KeyDown="OwnedQtyBox_KeyDown" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="LightGray" />

            <GroupBox Header="Description" Grid.Column="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <DockPanel Margin="4" LastChildFill="True">

                    <!-- Character Equipment Panel -->
                    <GroupBox Header="Equip" DockPanel.Dock="Top" Margin="0,0,0,6">
                        <StackPanel Margin="4">
                            <TextBlock Text="Character" Margin="0,0,0,2" />
                            <ComboBox x:Name="EquipCharacterBox" Margin="0,0,0,6" SelectionChanged="EquipCharacterBox_SelectionChanged" />

                            <TextBlock Text="Weapon" Margin="0,0,0,2" />
                            <controls:SearchableComboBox x:Name="EquipWeaponBox" Margin="0,0,0,6" OpenAbove="False" SelectionCommitted="PartyEquipBox_SelectionCommitted" />

                            <TextBlock Text="Armor: Body" Margin="0,0,0,2" />
                            <controls:SearchableComboBox x:Name="EquipArmorBodyBox" Margin="0,0,0,6" OpenAbove="False" SelectionCommitted="PartyEquipBox_SelectionCommitted" />

                            <TextBlock Text="Armor: Feet" Margin="0,0,0,2" />
                            <controls:SearchableComboBox x:Name="EquipArmorFeetBox" Margin="0,0,0,6" OpenAbove="False" SelectionCommitted="PartyEquipBox_SelectionCommitted" />

                            <TextBlock Text="Accessory" Margin="0,0,0,2" />
                            <controls:SearchableComboBox x:Name="EquipAccessoryBox" Margin="0,0,0,6" OpenAbove="False" SelectionCommitted="PartyEquipBox_SelectionCommitted" />

                            <Button Content="Set Equip" Click="SetEquip_Click" HorizontalAlignment="Left" />
                            <TextBlock x:Name="EquipResultText" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </GroupBox>

                    <!-- Info block -->
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Margin="0,0,6,6" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DescName" Text="-" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Category:" Margin="0,0,6,6" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DescCategory" Text="-" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="2" Grid.Column="0" x:Name="DescWeaponTypeLabel" Text="Weapon Type:" Margin="0,0,6,6" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DescWeaponType" Text="-" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="3" Grid.Column="0" x:Name="DescAttributeLabel" Text="Attribute:" Margin="0,0,6,6" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DescAttribute" Text="-" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="4" Grid.Column="0" x:Name="DescQtyLabel" Text="Qty:" Margin="0,0,6,6" Visibility="Collapsed" />
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DescQty" Text="-" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed" />
                    </Grid>

                    <!-- Equipment edit panel -->
                    <StackPanel x:Name="EditPanel" Visibility="Collapsed" VerticalAlignment="Bottom">
                        <Separator Margin="0,4,0,8" />

                        <TextBlock x:Name="EditResultText" Margin="0,0,0,8" TextWrapping="Wrap" />

                        <StackPanel x:Name="AttributeStatEdit" Margin="0,0,0,8">
                            <TextBlock Text="Attribute:" Margin="0,0,0,2" />
                            <controls:SearchableComboBox x:Name="EditAttributeBox"
                                                          OpenAbove="True" SelectionCommitted="EditAttributeBox_SelectionCommitted" />
                        </StackPanel>

                        <StackPanel x:Name="WeaponStatEdit" Margin="0,0,0,8" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Attack:" VerticalAlignment="Center" Width="60" />
                                <TextBox x:Name="EditAttackBox" Width="55" LostFocus="EditStatBox_LostFocus" KeyDown="EditStatBox_KeyDown" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Accuracy:" VerticalAlignment="Center" Width="60" />
                                <TextBox x:Name="EditAccuracyBox" Width="55" LostFocus="EditStatBox_LostFocus" KeyDown="EditStatBox_KeyDown" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="DefenceStatEdit" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                            <TextBlock Text="Defence:" VerticalAlignment="Center" Width="60" />
                            <TextBox x:Name="EditDefenceBox" Width="55" LostFocus="EditStatBox_LostFocus" KeyDown="EditStatBox_KeyDown" />
                        </StackPanel>
                        <StackPanel x:Name="EvasionStatEdit" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                            <TextBlock Text="Evasion:" VerticalAlignment="Center" Width="60" />
                            <TextBox x:Name="EditEvasionBox" Width="55" LostFocus="EditStatBox_LostFocus" KeyDown="EditStatBox_KeyDown" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>
    </DockPanel>
</UserControl>
