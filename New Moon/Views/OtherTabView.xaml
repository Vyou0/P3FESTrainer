<UserControl x:Class="P3FESTrainer.Views.OtherTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="10" HorizontalAlignment="Left">
            <!-- Name editing group -->
            <GroupBox Header="Protagonist Name" Width="260" Margin="0,0,0,10">
                <StackPanel Margin="6">
                    <TextBlock Text="First Name" Margin="0,0,0,2" />
                    <TextBox x:Name="GivenNameBox" Margin="0,0,0,6" />
                    <TextBlock Text="Last Name" Margin="0,0,0,2" />
                    <TextBox x:Name="SurnameBox" Margin="0,0,0,8" />
                    <Button Content="Set Name" Click="SetName_Click" HorizontalAlignment="Left" Padding="8,2" />
                </StackPanel>
            </GroupBox>

            <TextBlock x:Name="ResultText" Margin="0,6,0,0" Foreground="DarkGreen" VerticalAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
