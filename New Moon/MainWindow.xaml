<Window x:Class="P3FESTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:P3FESTrainer.Views"
        Title="Persona 3 FES Trainer" Height="720" Width="860" MinHeight="600" MinWidth="700">
    <DockPanel Margin="8">
        <!-- Top status bar & Yen controls -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="StatusText" Text="Not connected" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button x:Name="ConnectButton" Content="Connect" Click="Connect_Click" />
                    <Button x:Name="DisconnectButton" Content="Disconnect" Click="Disconnect_Click" Margin="4,0,0,0" IsEnabled="False" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <TextBlock Text="Yen:" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="YenBox" Width="100" VerticalContentAlignment="Center" />
                    <Button Content="Set Yen" Margin="4,0,0,0" Click="SetYen_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <TabControl>
            <TabItem Header="Stats">
                <views:StatsTabView x:Name="StatsTab" />
            </TabItem>
            <TabItem Header="Inventory">
                <views:InventoryTabView x:Name="InventoryTab" />
            </TabItem>
            <TabItem Header="Other">
                <views:OtherTabView x:Name="OtherTab" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
